{
  "organization": "Ridgeview Consulting Limited",
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": { "anchor": "Config", "relative-path": "Debug.xcconfig" } },
    { "name": "Release", "file": { "anchor": "Config", "relative-path": "Release.xcconfig" } },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "README.md" },
    {
      "kind": "group",
      "name": "Tooling",
      "children": [
        { "kind": "folder", "path": ".github" },
        {
          "kind": "group",
          "path": "fastlane",
          "children": [
            { "kind": "folder", "path": "metadata" },
            { "path": "Appfile" },
            { "path": "Deliverfile" },
            { "path": "Fastfile" },
            { "path": "Pluginfile" },
            { "path": "Snapfile" },
          ],
        },
        { "kind": "folder", "path": "Scripts" },
        { "path": ".gitignore" },
        { "path": ".ruby-version" },
        { "path": ".swift-format" },
        { "path": ".xcode-version" },
        { "path": "AGENTS.md" },
        { "path": "Gemfile" },
      ],
    }, {
      "kind": "group",
      "path": "Packages",
      "children": [
        {
          "kind": "group",
          "path": "TestPlans",
          "children": [
            { "path": "DataStores.xctestplan" },
            { "path": "Models.xctestplan" },
            { "path": "Shared.xctestplan" },
            { "path": "PresentationViews.xctestplan" },
          ],
        },
        { "path": "<PROJECT>/Packages/Models" },
        { "path": "DataStores" },
        { "path": "PresentationViews" },
        { "path": "Shared" },
      ],
    },
    { "kind": "folder", "path": "Config" },
    {
      "kind": "folder",
      "path": "TubeService",
      "target-membership": [
        "TubeService",
      ],
      "membership-exceptions": [
        {
          "target": "TubeService",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "TubeServiceTests",
      "target-membership": [
        "TubeService",
      ],
      "membership-exceptions": [
        {
          "target": "TubeService",
          "exclusions": [
            "LineStatus/LineStatusFilterOptionRequestTests.swift",
            "Notifications/NotificationPreferencesPatchBuilderTests.swift",
          ],
        }, {
          "target": "TubeServiceTests",
          "inclusions": [
            "LineStatus/LineStatusFilterOptionRequestTests.swift",
            "Notifications/NotificationPreferencesPatchBuilderTests.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "TubeServiceUITests",
      "target-membership": [
        "TubeServiceUITests",
      ],
      "membership-exceptions": [
        {
          "target": "TubeServiceUITests",
          "exclusions": [
            "Info.plist",
            "TestPlans/Screenshots.xctestplan",
            "TestPlans/UIFunctional.xctestplan",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Tube Service.app", "id": "318D482624EFC4900026B5F4", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TubeServiceUITests.xctest", "id": "315F89C72567BCB70069DD2D", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/TubeServiceTests.xctest", "id": "31E6EEED2C9DB4980042A66A", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "TubeService",
      "id": "318D482524EFC4900026B5F4",
      "product": "Products/Tube Service.app",
      "product-type": "application",
      "build-phases": [
        {
          "kind": "script",
          "name": "Swift format",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/Scripts/swift-format-lint.sh\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "DataStores",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Models",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PresentationViews",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Shared",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "TubeService/TubeService.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "Apple Development",
        "CODE_SIGN_STYLE[config=Debug]": "Automatic",
        "DEVELOPMENT_ASSET_PATHS": "\"TubeService/Preview Content\"",
        "DEVELOPMENT_TEAM": "3H5L23529U",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "INFOPLIST_FILE": "TubeService/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(MAIN_TARGET_BUNDLE_ID)",
        "PRODUCT_NAME": "Tube Service",
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug]": "",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release]": "match AppStore $(PRODUCT_BUNDLE_IDENTIFIER)",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TubeServiceTests",
      "id": "31E6EEEC2C9DB4980042A66A",
      "product": "Products/TubeServiceTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "TubeService",
      "dependencies": [
        "TubeService",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GCC_C_LANGUAGE_STANDARD": "gnu17",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.ridgeviewapps.TubeServiceTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Tube Service.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Tube Service",
      },
    }, {
      "name": "TubeServiceUITests",
      "id": "315F89C62567BCB70069DD2D",
      "product": "Products/TubeServiceUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "TubeService",
      "dependencies": [
        "TubeService",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "Shared",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "INFOPLIST_FILE": "TubeServiceUITests/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.ridgeviewapps.TubeServiceUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "TubeService",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "3H5L23529U",
    "ENABLE_BITCODE": "NO",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
    "MARKETING_VERSION": "$(APP_VERSION_NUMBER)",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "VALIDATE_PRODUCT[config=Release]": "YES",
    "VERSIONING_SYSTEM": "apple-generic",
  },
  "last-upgrade": "26.5",
  "last-swift-update": "16.0",
}
