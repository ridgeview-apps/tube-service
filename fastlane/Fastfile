default_platform(:ios)

before_all do
  setup_ci if is_ci  
end

private_lane :read_xcconfig_file do
  path = "../Config/CI/#{ENV["XCODE_CONFIG"]}.xcconfig"
  Xcodeproj::Config.new(path)
end

# Read directly: Xcodeproj::Config doesn't follow the CI xcconfigs' #includes
private_lane :app_version_number do
  Xcodeproj::Config.new("../Config/Base.xcconfig").attributes["APP_VERSION_NUMBER"]
end

# The en-GB App Store release notes, also used as the TestFlight "What to test"
private_lane :release_notes do
  File.read("metadata/en-GB/release_notes.txt").strip
end

private_lane :changelog do
  changelog_from_git_commits(
    commits_count: 1,
    date_format: "short"
  )
end


#######################
# Unit tests
#######################

private_lane :xcode_tests do |options|
  scan(
    scheme: options[:scheme],
    configuration: "Debug",
    device: "iPhone 18 Pro"
  )
end

lane :unit_tests do
  xcode_tests(scheme: "TubeService")
end

lane :ui_tests do
  xcode_tests(scheme: "TubeServiceUITests")
end


#######################
# Build & distribute
#######################

lane :add_badge_overlay do
  badge_shield_title = ENV["XCODE_CONFIG"].slice(0, 4)
  badge_shield_date_text = Time.new.strftime("%d.%m.%y")

  add_badge(
    shield: "#{badge_shield_title}-#{badge_shield_date_text}-blue",
    no_badge: true
  )
end

private_lane :main_target_bundle_id do
  read_xcconfig_file.attributes['MAIN_TARGET_BUNDLE_ID']
end

# App Store Connect's profile list leaves out EXPIRED profiles, so match can't
# see or replace them, yet their names stay taken and block it creating new
# ones. The bundle ID's own profile list still includes them, so delete them
# from there first
private_lane :delete_expired_match_profiles do |options|
  client = Spaceship::ConnectAPI.client.provisioning_request_client

  options[:bundle_ids].each do |identifier|
    bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier)
    next unless bundle_id

    profiles = client.get("v1/bundleIds/#{bundle_id.id}/profiles", { limit: 200 }).body["data"]
    profiles.each do |profile|
      attributes = profile["attributes"]
      next unless attributes["profileState"] == "EXPIRED" &&
                  attributes["name"] == "match AppStore #{identifier}"

      UI.important("Deleting expired profile '#{attributes["name"]}' (#{attributes["uuid"]})")
      Spaceship::ConnectAPI.delete_profile(profile_id: profile["id"])
    end
  end
end

lane :sync_signing do
  app_store_connect_api_key(duration: 1200)

  bundle_ids = [main_target_bundle_id]
  delete_expired_match_profiles(bundle_ids: bundle_ids)

  match(
    readonly: false,
    renew_expired_certs: true,
    clone_branch_directly: true,
    git_url: "git@github.com:ridgeview-apps/ridgeview-certs.git",
    git_private_key: ENV["MATCH_GIT_PRIVATE_KEY"],
    app_identifier: bundle_ids,
    username: "ci.ridgeview@gmail.com",
    type: "appstore"
  )
end

lane :build do
  bundle_id = main_target_bundle_id

  xcargs = [
    "TFL_API_APP_KEY=#{ENV.fetch("TFL_API_APP_KEY")}",
    "TUBE_SERVICE_API_KEY=#{ENV.fetch("TUBE_SERVICE_API_KEY")}",
  ].join(" ")

  increment_build_number(build_number: ENV["GITHUB_RUN_NUMBER"]) if is_ci

  gym(
    clean: true,
    scheme: "TubeService",
    configuration: "Release",
    xcargs: xcargs,
    xcconfig: "./Config/CI/#{ENV["XCODE_CONFIG"]}.xcconfig",
    export_method: "app-store",
    skip_profile_detection: true,
    # match runs in a separate fastlane call (sync_signing), so gym doesn't
    # inherit its profile mapping and needs it spelled out for the export
    export_options: {
      provisioningProfiles: { bundle_id => "match AppStore #{bundle_id}" }
    }
  )
end

lane :distribute do
  app_store_connect_api_key(duration: 1200)
  
  groups = ENV["DISTRIBUTION_GROUPS"] ? ENV["DISTRIBUTION_GROUPS"].split("\n") : []
  distribute_external = groups.length > 0  

  pilot(
    distribute_external: distribute_external,
    groups: groups,
    # pilot treats an empty groups array as truthy and would otherwise submit
    # internal-only builds for external Beta App Review
    submit_beta_review: distribute_external,
    notify_external_testers: true,
    skip_waiting_for_build_processing: !distribute_external,
    # With a changelog, pilot still waits for the build to appear in App Store
    # Connect even when skipping processing, so only set one for external builds
    # External testers get the App Store release notes as "What to test"
    changelog: distribute_external ? release_notes : nil,
    reject_build_waiting_for_review: true
  )
  
end


#######################
# App Store submission
#######################

lane :upload_screenshots do |options|
  upload_to_app_store_connect(
    submit_for_review: false,
    overwrite_screenshots: true
  )
end

lane :submit_for_review do |options|
  upload_to_app_store_connect(
    submit_for_review: true,
    build_number: options[:build_number]
  )
end

# Tags the submitted commit with its version. A resubmission after rejection
# moves the tag, so it always marks what was last sent to App Review
lane :tag_release do
  tag = app_version_number
  sh("git", "tag", "--force", tag)
  sh("git", "push", "--force", "origin", "refs/tags/#{tag}")
end

# Syncs release notes and other metadata to the App Store version, creating it
# if needed. Never uploads a binary or screenshots, or submits for review
lane :upload_metadata do
  app_store_connect_api_key(duration: 1200)

  version = app_version_number
  app = Spaceship::ConnectAPI::App.find(app_store_app_identifier)
  existing_version = app.get_app_store_versions(filter: { versionString: version }).first
  editable_version = app.get_edit_app_store_version

  # Once a version is approved or live its metadata is locked, and deliver
  # would try to create it again and fail
  if existing_version && existing_version.id != editable_version&.id
    UI.important("#{version} is #{existing_version.app_version_state} on App Store Connect, so its metadata can't be changed. Skipping")
    next
  end

  upload_to_app_store_connect(metadata_only: true)
end

# The App Store app is the one the Prod config builds, whichever config is active
private_lane :app_store_app_identifier do
  Xcodeproj::Config.new("../Config/CI/Prod.xcconfig").attributes["MAIN_TARGET_BUNDLE_ID"]
end

private_lane :upload_to_app_store_connect do |options|
  app_store_connect_api_key(duration: 1200)

  app_identifier = app_store_app_identifier
  submit_for_review = options[:submit_for_review] || false
  overwrite_screenshots = options[:overwrite_screenshots] || false
  metadata_only = options[:metadata_only] || false

  if submit_for_review
    build_number = options[:build_number] || latest_testflight_build_number(app_identifier: app_identifier).to_s
  end
  
  deliver(
    app_identifier: app_identifier,
    # Creates the version on App Store Connect if it doesn't exist yet
    app_version: app_version_number,
    automatic_release: false,
    submit_for_review: submit_for_review,
    overwrite_screenshots: overwrite_screenshots,
    # The Prod build job leaves its .ipa in the checkout, which deliver would
    # otherwise pick up and upload again
    skip_binary_upload: metadata_only,
    skip_screenshots: metadata_only,
    precheck_include_in_app_purchases: false,
    force: true, # Skips the interactive preview of html file before uploading
    build_number: build_number,
    submission_information: {
      add_id_info_uses_idfa: false,
      add_id_info_serves_ads: false,
      add_id_info_tracks_action: false,
      add_id_info_tracks_install: false,
      add_id_info_limits_tracking: true,
      # content_rights_contains_third_party_content: true,
      # content_rights_has_rights: true,
    }
  )
end


#######################
# Releases
#######################

# Run locally on main to start a release: pushes release/<version> for the
# version in Base.xcconfig (which starts the Prod workflow), then bumps main to
# the next minor version, or major with bump:major. dry_run:true only prints
# what it would do
lane :start_release do |options|
  bump = options[:bump] || "minor"
  UI.user_error!("bump must be minor or major, not '#{bump}'") unless %w[minor major].include?(bump)

  ensure_git_branch(branch: "^main$")
  ensure_git_status_clean
  sh("git", "pull", "--ff-only")

  version = app_version_number
  major, minor = version.split(".").map(&:to_i)
  next_version = bump == "major" ? "#{major + 1}.0.0" : "#{major}.#{minor + 1}.0"
  release_branch = "release/#{version}"

  # ls-remote --exit-code succeeds only if the branch exists
  if system("git", "ls-remote", "--exit-code", "--heads", "origin", release_branch, out: File::NULL)
    UI.user_error!("#{release_branch} already exists on origin")
  end

  # A last look at the notes, which are easy to forget to update
  UI.message("Release notes for #{version}:\n#{release_notes.gsub(/^/, "  ")}")

  plan = "Push #{release_branch} from main, then bump main from #{version} to #{next_version}"
  if options[:dry_run]
    UI.message("Dry run: #{plan}")
    next
  end
  next unless UI.confirm("#{plan}?")

  sh("git", "push", "origin", "HEAD:refs/heads/#{release_branch}")

  xcconfig_path = "../Config/Base.xcconfig"
  contents = File.read(xcconfig_path)
  File.write(xcconfig_path, contents.sub(/^(\s*APP_VERSION_NUMBER\s*=\s*)[^\s\/]+/) { "#{$1}#{next_version}" })
  UI.user_error!("Couldn't update APP_VERSION_NUMBER in #{xcconfig_path}") unless app_version_number == next_version

  sh("git", "commit", "-m", "Bump version to #{next_version}", "--", xcconfig_path)
  sh("git", "push", "origin", "main")
end
