  xcode_tests(scheme: "TubeServiceUITests")
end


#######################
# Build & distribute
#######################

lane :add_badge_overlay do
  badge_shield_title = ENV["XCODE_CONFIG"].slice(0, 4)
  badge_shield_date_text = Time.new.strftime("%d.%m.%y")

  add_badge(
    shield: "#{badge_shield_title}-#{badge_shield_date_text}-blue",
    no_badge: true
  )
end

private_lane :main_target_bundle_id do
  read_xcconfig_file.attributes['MAIN_TARGET_BUNDLE_ID']
end

# App Store Connect's profile list leaves out EXPIRED profiles, so match can't
# see or replace them, yet their names stay taken and block it creating new
# ones. The bundle ID's own profile list still includes them, so delete them
# from there first
private_lane :delete_expired_match_profiles do |options|
  client = Spaceship::ConnectAPI.client.provisioning_request_client

  options[:bundle_ids].each do |identifier|
    bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier)
    next unless bundle_id

    profiles = client.get("v1/bundleIds/#{bundle_id.id}/profiles", { limit: 200 }).body["data"]
    profiles.each do |profile|
      attributes = profile["attributes"]
      next unless attributes["profileState"] == "EXPIRED" &&
                  attributes["name"] == "match AppStore #{identifier}"

      UI.important("Deleting expired profile '#{attributes["name"]}' (#{attributes["uuid"]})")
      Spaceship::ConnectAPI.delete_profile(profile_id: profile["id"])
    end
  end
end

lane :sync_signing do
  app_store_connect_api_key(duration: 1200)

  bundle_ids = [main_target_bundle_id]
  delete_expired_match_profiles(bundle_ids: bundle_ids)

  match(
    readonly: false,
    renew_expired_certs: true,
    clone_branch_directly: true,
    git_url: "git@github.com:ridgeview-apps/ridgeview-certs.git",
    git_private_key: ENV["MATCH_GIT_PRIVATE_KEY"],
    app_identifier: bundle_ids,
    username: "ci.ridgeview@gmail.com",
    type: "appstore"
  )
end

lane :build do
  bundle_id = main_target_bundle_id

  xcargs = [
    "TFL_API_APP_KEY=#{ENV.fetch("TFL_API_APP_KEY")}",
    "TUBE_SERVICE_API_KEY=#{ENV.fetch("TUBE_SERVICE_API_KEY")}",
  ]
  # agvtool (increment_build_number) can't edit the JSON project format
  xcargs << "CURRENT_PROJECT_VERSION=#{ENV.fetch("GITHUB_RUN_NUMBER")}" if is_ci

  gym(
    clean: true,
    scheme: "TubeService",
    configuration: "Release",
    xcargs: xcargs.join(" "),
    xcconfig: "./Config/CI/#{ENV["XCODE_CONFIG"]}.xcconfig",
    export_method: "app-store",
    skip_profile_detection: true,
    # match runs in a separate fastlane call (sync_signing), so gym doesn't
    # inherit its profile mapping and needs it spelled out for the export
    export_options: {
      provisioningProfiles: { bundle_id => "match AppStore #{bundle_id}" }
    }
  )
end

lane :distribute do
  app_store_connect_api_key(duration: 1200)
  
  groups = ENV["DISTRIBUTION_GROUPS"] ? ENV["DISTRIBUTION_GROUPS"].split("\n") : []
  distribute_external = groups.length > 0  

  pilot(
    distribute_external: distribute_external,
    groups: groups,
    # pilot treats an empty groups array as truthy and would otherwise submit
    # internal-only builds for external Beta App Review
    submit_beta_review: distribute_external,
    notify_external_testers: true,
    skip_waiting_for_build_processing: !distribute_external,
    # With a changelog, pilot still waits for the build to appear in App Store
    # Connect even when skipping processing, so only set one for external builds
    # External testers get the App Store release notes as "What to test"
    changelog: distribute_external ? release_notes : nil,
    reject_build_waiting_for_review: true
  )
  
end


#######################
# Screenshots
#######################

# Generates the App Store screenshots into an absolute output_directory, e.g.
# output_directory:/tmp/screenshots. device:"iPhone 18 Pro Max" generates just
# one of the Snapfile's devices. Needs no App Store Connect key
lane :screenshots do |options|
  output_directory = options[:output_directory].to_s
  UI.user_error!("output_directory must be an absolute path, not '#{output_directory}'") unless output_directory.start_with?("/")

  # snapshot copies everything in its cache into the output, and only empties
  # the cache after a run that passes, so a failed run would leave screenshots
  # behind for the next run to pass off as its own
  FileUtils.rm_rf(File.expand_path("~/Library/Caches/tools.fastlane/screenshots"))

  snapshot_options = { output_directory: output_directory }
  snapshot_options[:devices] = [options[:device]] if options[:device]
  snapshot(snapshot_options)

  # ScreenshotTests captures 10 per device
  expected_count = Snapshot.config[:devices].count * 10
  actual_count = Dir[File.join(output_directory, "*", "*.png")].count
  UI.user_error!("Expected #{expected_count} screenshots in #{output_directory}, found #{actual_count}") unless actual_count == expected_count
end


#######################
# App Store submission
#######################

# Replaces the App Store version's screenshots with the ones in an absolute
# screenshots_path, e.g. from the screenshots lane. Never uploads metadata or a
# binary, or submits for review
lane :upload_screenshots do |options|
  screenshots_path = options[:screenshots_path].to_s
  UI.user_error!("screenshots_path must be an absolute path, not '#{screenshots_path}'") unless screenshots_path.start_with?("/")

  app_store_connect_api_key(duration: 1200)

  # Unlike upload_metadata, fail rather than skip: screenshots are uploaded on
  # purpose, so a silent skip would look like they'd gone up
  version = app_version_number
  app = Spaceship::ConnectAPI::App.find(app_store_app_identifier)
  existing_version = app.get_app_store_versions(filter: { versionString: version }).first
  editable_version = app.get_edit_app_store_version
  if existing_version && existing_version.id != editable_version&.id
    UI.user_error!("#{version} is #{existing_version.app_version_state} on App Store Connect, so its screenshots can't be changed")
  end
  UI.user_error!("#{version} is in review, so its screenshots can't be changed") if build_number_in_review

  upload_to_app_store_connect(screenshots_path: screenshots_path)
end

# If another build of the version is in review, this is a resubmission, so
# deliver removes that build from review first. If this build is the one in
# review (e.g. a re-run after a later step failed), there's nothing to submit
lane :submit_for_review do |options|
  app_store_connect_api_key(duration: 1200)

  build_number = (options[:build_number] || latest_testflight_build_number(app_identifier: app_store_app_identifier)).to_s
  build_in_review = build_number_in_review

  if build_in_review == build_number
    UI.important("Build #{build_number} is already in review. Skipping")
    next
  end
  UI.important("Removing build #{build_in_review} from review to submit build #{build_number}") if build_in_review

  upload_to_app_store_connect(
    submit_for_review: true,
    build_number: build_number,
    reject_if_possible: !build_in_review.nil?
  )
end

# Releases the approved version to the App Store. A version that's already live
# is skipped, so re-running the job is harmless
lane :publish do
  app_store_connect_api_key(duration: 1200)

  version = app_version_number
  app = Spaceship::ConnectAPI::App.find(app_store_app_identifier)
  app_store_version = app.get_app_store_versions(filter: { versionString: version }).first
  UI.user_error!("#{version} isn't on App Store Connect") unless app_store_version

  states = Spaceship::ConnectAPI::AppStoreVersion::AppVersionState
  state = app_store_version.app_version_state
  if state == states::READY_FOR_DISTRIBUTION
    UI.important("#{version} is already on the App Store. Skipping")
    next
  end
  unless state == states::PENDING_DEVELOPER_RELEASE
    UI.user_error!("#{version} is #{state}, so it can't be published yet. Re-run this job once Apple has approved it")
  end

  app_store_version.create_app_store_version_release_request
  UI.success("Released #{version} to the App Store")
end

# Syncs release notes and other metadata to the App Store version, creating it
# if needed. Never uploads a binary or screenshots, or submits for review
lane :upload_metadata do
  app_store_connect_api_key(duration: 1200)

  version = app_version_number
  app = Spaceship::ConnectAPI::App.find(app_store_app_identifier)
  existing_version = app.get_app_store_versions(filter: { versionString: version }).first
  editable_version = app.get_edit_app_store_version

  # Once a version is approved or live its metadata is locked, and deliver
  # would try to create it again and fail
  if existing_version && existing_version.id != editable_version&.id
    UI.important("#{version} is #{existing_version.app_version_state} on App Store Connect, so its metadata can't be changed. Skipping")
    next
  end

  # Metadata is locked while in review. Submit for review uploads it once it
  # has removed the build from review
  build_in_review = build_number_in_review
  if build_in_review
    message = "Approving Submit for review will remove build #{build_in_review} of #{version} from review and submit build #{ENV.fetch("GITHUB_RUN_NUMBER", "?")} instead"
    UI.important("#{version} is in review, so its metadata is uploaded on resubmission. #{message}")
    File.write(ENV["GITHUB_STEP_SUMMARY"], "⚠️ #{message}\n", mode: "a") if ENV["GITHUB_STEP_SUMMARY"]
    next
  end

  upload_to_app_store_connect(metadata_only: true)
end

# The App Store app is the one the Prod config builds, whichever config is active
private_lane :app_store_app_identifier do
  Xcodeproj::Config.new("../Config/CI/Prod.xcconfig").attributes["MAIN_TARGET_BUNDLE_ID"]
end

# The build number of this version that's in App Review, or nil if none is. If
# a different version is in review, upload_to_app_store_connect refuses, so a
# resubmission can't remove that from review
private_lane :build_number_in_review do
  app = Spaceship::ConnectAPI::App.find(app_store_app_identifier)
  next nil unless app.get_in_progress_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)

  editable_version = app.get_edit_app_store_version
  next nil unless editable_version&.version_string == app_version_number

  editable_version.build&.version
end

private_lane :upload_to_app_store_connect do |options|
  app_store_connect_api_key(duration: 1200)

  app_identifier = app_store_app_identifier
  version = app_version_number

  # deliver renames an editable version whose number differs, e.g. turning a
  # rejected 2.1.0 into 2.2.0, so refuse instead
  editable_version = Spaceship::ConnectAPI::App.find(app_identifier).get_edit_app_store_version
  if editable_version && editable_version.version_string != version
    UI.user_error!("App Store Connect's editable version is #{editable_version.version_string} (#{editable_version.app_version_state}), not #{version}. Deal with it on App Store Connect first, or deliver would rename it to #{version}")
  end

  submit_for_review = options[:submit_for_review] || false
  metadata_only = options[:metadata_only] || false
  # Uploading screenshots replaces all of them, and nothing else. Otherwise
  # they're left alone
  screenshots_path = options[:screenshots_path]
  screenshots_only = !screenshots_path.nil?

  deliver(
    app_identifier: app_identifier,
    # Creates the version on App Store Connect if it doesn't exist yet
    app_version: version,
    automatic_release: false,
    submit_for_review: submit_for_review,
    overwrite_screenshots: screenshots_only,
    screenshots_path: screenshots_path,
    # Re-uploads screenshots stuck processing after 10 minutes, not an hour
    screenshot_processing_timeout: 600,
    # deliver uploads the newest .ipa in the working directory unless told not
    # to, and the build lane leaves one there
    skip_binary_upload: metadata_only || screenshots_only,
    skip_screenshots: !screenshots_only,
    skip_metadata: screenshots_only,
    # deliver only uploads the age rating when given its path
    app_rating_config_path: File.expand_path("metadata/rating_config.json"),
    precheck_include_in_app_purchases: false,
    force: true, # Skips the interactive preview of html file before uploading
    build_number: options[:build_number],
    # Cancels the review submission in progress before submitting this build
    reject_if_possible: options[:reject_if_possible] || false,
    submission_information: {
      add_id_info_uses_idfa: false,
      add_id_info_serves_ads: false,
      add_id_info_tracks_action: false,
      add_id_info_tracks_install: false,
      add_id_info_limits_tracking: true,
      # content_rights_contains_third_party_content: true,
      # content_rights_has_rights: true,
    }
  )
end


#######################
# Releases
#######################

# Prints the version in Base.xcconfig and the one after it: the next minor
# version, or major with bump:major. On CI both are also step outputs, so
# workflows get the version without parsing the xcconfig themselves
lane :release_versions do |options|
  bump = options[:bump] || "minor"
  UI.user_error!("bump must be minor or major, not '#{bump}'") unless %w[minor major].include?(bump)

  version = app_version_number.to_s
  UI.user_error!("APP_VERSION_NUMBER must look like 1.2.3, not '#{version}'") unless version.match?(/\A\d+\.\d+\.\d+\z/)

  major, minor = version.split(".").map(&:to_i)
  next_version = bump == "major" ? "#{major + 1}.0.0" : "#{major}.#{minor + 1}.0"

  outputs = "version=#{version}\nnext_version=#{next_version}\n"
  UI.message(outputs)
  File.write(ENV["GITHUB_OUTPUT"], outputs, mode: "a") if ENV["GITHUB_OUTPUT"]
end

# Sets APP_VERSION_NUMBER in Base.xcconfig, e.g. version:2.2.0
lane :set_version do |options|
  version = options[:version].to_s
  UI.user_error!("version must look like 1.2.3, not '#{version}'") unless version.match?(/\A\d+\.\d+\.\d+\z/)

  xcconfig_path = "../Config/Base.xcconfig"
  contents = File.read(xcconfig_path)
  File.write(xcconfig_path, contents.sub(/^(\s*APP_VERSION_NUMBER\s*=\s*)[^\s\/]+/) { "#{$1}#{version}" })
  UI.user_error!("Couldn't update APP_VERSION_NUMBER in #{xcconfig_path}") unless app_version_number == version
end
