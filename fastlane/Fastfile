default_platform(:ios)

before_all do
  setup_ci if is_ci  
end

private_lane :read_xcconfig_file do
  path = "../Config/CI/#{ENV["XCODE_CONFIG"]}.xcconfig"
  Xcodeproj::Config.new(path)
end

# Read directly: Xcodeproj::Config doesn't follow the CI xcconfigs' #includes
private_lane :app_version_number do
  Xcodeproj::Config.new("../Config/Base.xcconfig").attributes["APP_VERSION_NUMBER"]
end

# The en-GB App Store release notes, also used as the TestFlight "What to test"
private_lane :release_notes do
  File.read("metadata/en-GB/release_notes.txt").strip
end

private_lane :changelog do
  changelog_from_git_commits(
    commits_count: 1,
    date_format: "short"
  )
end


