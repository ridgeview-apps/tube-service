scheme("TubeServiceUITests")
testplan("Screenshots")

devices([
    "iPhone 18 Pro Max",
    "iPad Pro 13-inch (M5)",
])

languages([
  "en-GB"
])
localize_simulator(true)
# Fail on the first error rather than retrying, so flaky screenshots show up instead of being hidden.
number_of_retries(0)
# snapshot only spots failed tests in the *_TestSummaries.plist files Xcode no longer writes, so without this a failed
# run still exits 0. This fails it when xcodebuild does.
stop_after_first_error(true)
# After a failed test, Xcode spends 10 minutes collecting diagnostics from the simulator before it exits.
xcargs("-collect-test-diagnostics never")

clear_previous_screenshots(true)
override_status_bar(true)
# The screenshot fixtures' clock (`UITestScenario.Fixtures.now`): Friday 12 June 2026, 09:41 in London. A full date
# also sets the date the iPad shows; simctl only accepts it with fractional seconds. The simulator shows it in the
# Mac's time zone, so it's given in that zone (Time.new's default) to read 09:41 on any Mac, CI's UTC runners included.
# The rest are fastlane's defaults.
status_bar_time = Time.new(2026, 6, 12, 9, 41).iso8601(3)
override_status_bar_arguments(
  "--time #{status_bar_time} --dataNetwork wifi --wifiMode active --wifiBars 3 --cellularMode active " \
  "--operatorName '' --cellularBars 4 --batteryState charged --batteryLevel 100"
)
